# DB（docker-compose の postgres と揃える）
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=CHANGE_ME
DB_NAME=auth_db
DB_SSLMODE=disable

# Server（Step4 用）
SERVER_PORT=8080
SERVER_BASE_URL=http://localhost:8080
LOGIN_URL=http://localhost:5173/login
CORS_ORIGIN=http://localhost:5173
OAUTH_ISSUER=http://localhost:8080
CONSENT_URL=http://localhost:5173/consent

# 起動時 DB 初期化（Render 等で Pre-Deploy が使えない場合）
# AUTO_MIGRATE_ON_START=true
# AUTO_SEED_ON_START=true
# AUTO_SEED_PASSWORD=password123
# AUTO_SEED_REDIRECT_URI=http://localhost:5173/callback
